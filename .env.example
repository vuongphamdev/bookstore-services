# ===========================================
# Database Configuration
# ===========================================
DB_HOST=localhost
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_NAME=courifly_db
DB_ROOT_PASSWORD=your_root_password

# Migration user (optional - for database migrations)
DB_MIGRATION_USER=your_migration_user
DB_MIGRATION_PASSWORD=your_migration_password

# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=development
PORT=3000
SERVER_URL=http://localhost:3000

# ===========================================
# JWT Configuration
# ===========================================
# Secrets (use strong random strings in production)
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_TOKEN_SECRET=your-access-token-secret-change-in-production
JWT_REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
JWT_FORGOT_PASSWORD_TOKEN_SECRET=your-forgot-password-secret-change-in-production
JWT_VERIFY_EMAIL_TOKEN_SECRET=your-verify-email-secret-change-in-production

# Expiration times (e.g., 15m, 1h, 7d, 30d)
JWT_ACCESS_TOKEN_EXPIRE_TIME=15m
JWT_REFRESH_TOKEN_EXPIRE_TIME=7d
JWT_FORGOT_PASSWORD_TOKEN_EXPIRE_TIME=1h
JWT_VERIFY_EMAIL_TOKEN_EXPIRE_TIME=24h

# ===========================================
# Security
# ===========================================
# Password hashing salt rounds (bcrypt)
PASSWORD_SALT=10