            ],
            "url": {
              "raw": "{{BASE_URL}}/refresh-token",
              "host": ["{{BASE_URL}}"],
              "path": ["refresh-token"]
            },
            "description": "Refresh access token using refresh token from HTTP-only cookie. No body required."
          }
