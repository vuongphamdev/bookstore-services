  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Generate dynamic test data",
          "",
          "// Generate random stock operation",
          "const operations = ['add', 'subtract'];",
          "pm.globals.set('randomOperation', operations[Math.floor(Math.random() * operations.length)]);",
          "",
          "// Generate random order status",
          "const statuses = ['pending', 'processing', 'shipped', 'delivered', 'cancelled'];",
          "pm.globals.set('randomStatus', statuses[Math.floor(Math.random() * statuses.length)]);",
          "",
          "// Generate random quantity between 1-10",
          "pm.globals.set('randomQuantity', Math.floor(Math.random() * 10) + 1);",
          "",
          "// Generate random price between 5.00 - 99.99",
          "pm.globals.set('randomBookPrice', (Math.random() * 95 + 5).toFixed(2));",
          "",
          "// Generate random stock between 0-100",
          "pm.globals.set('randomStock', Math.floor(Math.random() * 101));"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Common test scripts",
          "pm.test('Status code should be successful', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204]);",
          "});",
          "",
          "pm.test('Response should have success field', function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('success');",
          "});",
          "",
          "pm.test('Response should have message field', function () {",
          "    const jsonData = pm.response.json();",
          "    pm.expect(jsonData).to.have.property('message');",
          "});"
        ]
      }
    }
