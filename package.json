{
  "name": "courifly-services",
  "version": "1.0.0",
  "description": "Courifly - Courier delivery and order tracking platform API",
  "main": "index.js",
  "scripts": {
    "generate": "tsoa spec-and-routes && npm run gen-postman",
    "gen-postman": "openapi2postmanv2 -s docs/swagger.json -o postman/postman-collection.json -p",
    "predev": "npm run generate",
    "prebuild": "npm run generate",
    "_dev": "nodemon --watch src --ext ts --exec \"ts-node -r tsconfig-paths/register src/index.ts\"",
    "dev": "npm run dev:development",
    "dev:development": "NODE_ENV=development npm run _dev",
    "dev:staging": "NODE_ENV=staging npm run _dev",
    "dev:production": "NODE_ENV=production npm run _dev",
    "build": "npm run build:clean && npm run build:compile",
    "build:clean": "rm -rf dist",
    "build:compile": "tsc && tsc-alias",
    "build:watch": "tsc --watch",
    "start": "npm run start:production",
    "start:development": "NODE_ENV=development node dist/index.js",
    "start:staging": "NODE_ENV=staging node dist/index.js",
    "start:production": "NODE_ENV=production node dist/index.js",
    "preview": "npm run build && npm run start:production",
    "db:migrate:latest": "knex --knexfile src/db/knexfile.ts migrate:latest",
    "db:migrate:rollback": "knex --knexfile src/db/knexfile.ts migrate:rollback",
    "db:migrate:rollback:all": "knex --knexfile src/db/knexfile.ts migrate:rollback --all",
    "db:migrate:status": "knex --knexfile src/db/knexfile.ts migrate:status",
    "db:migrate:make": "knex --knexfile src/db/knexfile.ts migrate:make",
    "db:seed:run": "knex --knexfile src/db/knexfile.ts seed:run",
    "db:seed:massive": "knex --knexfile src/db/knexfile.ts seed:run --specific=01_massive_data.ts",
    "db:reset": "npm run db:migrate:rollback && npm run db:migrate:latest && npm run db:seed:run",
    "test": "NODE_ENV=test jest",
    "test:watch": "NODE_ENV=test jest --watch",
    "test:coverage": "NODE_ENV=test jest --coverage",
    "test:ci": "NODE_ENV=test jest --ci --coverage --watchAll=false",
    "lint": "eslint src --ext .ts,.js",
    "lint:fix": "eslint src --ext .ts,.js --fix",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,js,json}\"",
    "type-check": "tsc --noEmit",
    "clean": "rm -rf dist node_modules/.cache",
    "clean:all": "rm -rf dist node_modules package-lock.json && npm install",
    "health": "echo '🏥 Health Check...' && curl -w '\\n✅ Status: %{http_code} | Time: %{time_total}s\\n' http://localhost:3000/ping || (echo '❌ Health check failed!' && exit 1)"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com-vuongphamdev:vuongphamdev/migration-project.git"
  },
  "keywords": [
    "courier",
    "delivery",
    "tracking",
    "logistics",
    "order-management"
  ],
  "author": "VP",
  "license": "ISC",
  "dependencies": {
    "@faker-js/faker": "^10.0.0",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "express-validator": "^7.2.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "knex": "^3.1.0",
    "lodash": "^4.17.21",
    "mysql2": "^3.14.4",
    "swagger-ui-express": "^5.0.1",
    "tsoa": "^7.0.0-alpha.0",
    "yamljs": "^0.3.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/express-rate-limit": "^5.1.3",
    "@types/faker": "^6.6.8",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/lodash": "^4.17.20",
    "@types/node": "^24.3.0",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/yamljs": "^0.2.34",
    "@typescript-eslint/eslint-plugin": "^8.46.4",
    "@typescript-eslint/parser": "^8.46.4",
    "eslint": "^9.39.1",
    "jest": "^30.2.0",
    "nodemon": "^3.1.10",
    "openapi-to-postmanv2": "^5.7.0",
    "prettier": "3.6.2",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.46.4"
  }
}
